---
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GoNest - A Progressive Go Framework</title>
  <meta name="description" content="Build efficient, reliable, and scalable server-side applications in Go with NestJS-inspired architecture." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="GoNest Documentation" href="/rss.xml" />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MQCK3Y7R3W"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-MQCK3Y7R3W');

    document.addEventListener('click', function (e) {
      var el = e.target.closest('[data-ga-event]');
      if (!el) return;
      gtag('event', el.getAttribute('data-ga-event'), {
        link_url: el.getAttribute('href') || undefined,
        link_text: (el.textContent || '').trim() || undefined,
      });
    });
  </script>
</head>
<body>
  <Header />
  <slot />
</body>
</html>
